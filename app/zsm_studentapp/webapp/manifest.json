{
  "_version": "1.76.0",
  "sap.app": {
    "id": "zsmstudentapp",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.6",
      "toolsId": "d8b0a38a-df5b-48bd-9cb5-9e450d349e84"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/z-service-students/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {},
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "zsmstudentapp.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.143.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zsmstudentapp.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlId": "app",
        "controlAggregation": "pages",
        "viewType": "XML",
        "viewPath": "zsmstudentapp.view",
        "async": true,
        "transition": "slide"
      },
      "routes": [
        {
          "name": "HomeRoute",
          "pattern": "",
          "target": "HomeTarget"
        },
        {
          "name": "StudentRoute",
          "pattern": "students",
          "target": "StudentTarget"
        }
      ],
      "targets": {
        "HomeTarget": {
          "viewName": "Home",
          "viewId": "Home",
          "viewLevel": 1
        },
        "StudentTarget": {
          "viewName": "zsm_studentapp",
          "viewId": "Student",
          "viewLevel": 2
        }
      }
    }
  }
}