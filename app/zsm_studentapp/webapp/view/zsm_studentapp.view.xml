<mvc:View
    controllerName="zsmstudentapp.controller.zsm_studentapp"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Page
        id="page"
        title="Student List"
    >
        <headerContent>
            <Toolbar>
                <Button
                    text="Add"
                    icon="sap-icon://add"
                    press=".onAdd"
                />
                <Button
                    text="Update"
                    icon="sap-icon://edit"
                    press=".onUpdate"
                />
                <Button
                    text="Delete"
                    icon="sap-icon://delete"
                    press=".onDelete"
                />
                <ToolbarSpacer />
                <Button
                    icon="sap-icon://refresh"
                    press=".onRefresh"
                />
            </Toolbar>
        </headerContent>

        <content>
            <Table
                id="studentTable"
                mode="SingleSelectMaster"
                items="{
                    path: '/Students',
                    parameters: { 
                        expand: 'details' 
                    }
                }"
                itemPress=".onRowPress"
            >
                <columns>
                    <Column>
                        <Text text="ID" />
                    </Column>
                    <Column>
                        <Text text="First Name" />
                    </Column>
                    <Column>
                        <Text text="Last Name" />
                    </Column>
                    <Column>
                        <Text text="Class" />
                    </Column>
                    <Column>
                        <Text text="Section" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Active">
                        <cells>
                            <Text text="{studentID}" />
                            <Text text="{firstName}" />
                            <Text text="{lastName}" />
                            <Text text="{class}" />
                            <Text text="{section}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>

            <Panel
                id="detailPanel"
                headerText="Student Details"
                visible="false"
                class="sapUiSmallMarginTop"
                expandable="false"
                expanded="true"
            >
                <VBox
                    id="detailVBox"
                    class="sapUiSmallMargin"
                >
                    <Text text="ID: {studentID}" />
                    <Text text="First Name: {firstName}" />
                    <Text text="Last Name: {lastName}" />
                    <Text text="Class: {class}" />
                    <Text text="Section: {section}" />

                    <Text text="Email: {details/email}" />
                    <Text text="Phone: {details/phoneNumber}" />
                    <Text text="Guardian: {details/guardianName}" />
                    <Text
                        text="Emergency Contact: {details/emergencyContactName}"
                    />
                    <Text text="Address: {details/address}" />

                    <Text text="Date of Birth: {details/dateOfBirth}" />
                    <Text text="Enrollment Date: {details/enrollmentDate}" />
                </VBox>
            </Panel>
        </content>
    </Page>
</mvc:View>
