<mvc:View
    controllerName="zsmstudentapp.controller.zsm_studentapp"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page id="page" title="Student List">

        <headerContent>
            <Toolbar>
                <Button text="Add" icon="sap-icon://add" press=".onAdd" />
                <Button text="Update" icon="sap-icon://edit" press=".onUpdate" />
                <Button text="Delete" icon="sap-icon://delete" press=".onDelete" />
                <ToolbarSpacer />
                <Button icon="sap-icon://refresh" press=".onRefresh" />
            </Toolbar>
        </headerContent>

        <content>

            <!-- STUDENTS TABLE -->
            <Table
                id="studentTable"
                mode="SingleSelectMaster"
                items="{
                    path: '/Students',
                    parameters: { expand: 'details' }
                }"
                itemPress=".onRowPress">

                <columns>
                    <Column><Text text="ID"/></Column>
                    <Column><Text text="First Name"/></Column>
                    <Column><Text text="Last Name"/></Column>
                    <Column><Text text="Class"/></Column>
                    <Column><Text text="Section"/></Column>
                </columns>

                <items>
                    <ColumnListItem type="Active">
                        <cells>
                            <Text text="{studentID}" />
                            <Text text="{firstName}" />
                            <Text text="{lastName}" />
                            <Text text="{class}" />
                            <Text text="{section}" />
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>

            <!-- DETAILS PANEL -->
            <Panel
                id="detailPanel"
                headerText="Student Details"
                visible="false"
                class="sapUiSmallMarginTop"
                expandable="true"
                expanded="true">

                <VBox class="sapUiSmallMargin">
                    <Text id="detailID" />
                    <Text id="detailFirstName" />
                    <Text id="detailLastName" />
                    <Text id="detailClass" />
                    <Text id="detailSection" />
                    <Text id="detailEmail" />
                    <Text id="detailPhone" />
                    <Text id="detailGuardian" />
                    <Text id="detailAddress" />
                    <Text id="detailDOB" />
                    <Text id="detailEnroll" />
                </VBox>
            </Panel>

        </content>
    </Page>
</mvc:View>
