<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Dialog
        id="studentDialog"
        title="Student Details"
        resizable="true"
        contentWidth="500px"
    >
        <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
            <core:Title text="Core Data" />
            
            <Label text="Student ID" required="true"/>
            <Input id="dialogStudentID" value="{temp>studentID}" editable="true"/>

            <Label text="First Name" required="true"/>
            <Input id="dialogFirstName" value="{temp>firstName}" />
            
            <Label text="Last Name" required="true"/>
            <Input id="dialogLastName" value="{temp>lastName}" />

            <Label text="Class" required="true"/>
            <Input id="dialogClass" value="{temp>class}" />

            <Label text="Section" required="true"/>
            <Input id="dialogSection" value="{temp>section}" />

            <core:Title text="Contact &amp; Details" />

            <Label text="Email" required="true"/>
            <Input id="dialogEmail" value="{temp>details/email}" type="Email"/>

            <Label text="Phone Number" required="true"/>
            <Input id="dialogPhone" value="{temp>details/phoneNumber}" type="Tel"/>
            
            <Label text="Guardian Name" required="true"/>
            <Input id="dialogGuardianName" value="{temp>details/guardianName}" />
            
            <Label text="Emergency Contact Name" required="true"/>
            <Input id="dialogEmergencyContactName" value="{temp>details/emergencyContactName}" />

            <Label text="Address" required="true"/>
            <Input id="dialogAddress" value="{temp>details/address}" />

            <Label text="Date of Birth" required="true"/>
            <DatePicker id="dialogDOB" value="{temp>details/dateOfBirth}" displayFormat="long"/>

            <Label text="Enrollment Date" required="true"/>
            <DatePicker id="dialogEnrollDate" value="{temp>details/enrollmentDate}" displayFormat="long"/>
            
        </f:SimpleForm>

        <beginButton>
            <Button text="Save" type="Accept" press=".onSaveDialog" />
        </beginButton>
        <endButton>
            <Button text="Cancel" type="Reject" press=".onCancelDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>